{
  "opencollection": "1.0.0",
  "info": {
    "name": "Clients Client Info Lab Info API",
    "version": "0.16.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-ConfidentCannabis-APIKey",
      "value": "{{X-ConfidentCannabis-APIKey}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Lab Info",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get lab information",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.confidentcannabis.com/v0/labs/lab"
          },
          "docs": "Returns information about the authenticated lab organization."
        }
      ]
    }
  ],
  "bundled": true
}