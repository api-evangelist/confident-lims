      },
      "item": [
        {
          "id": "161292b9-e4bb-42dd-8105-0bdf9bfeae0c",
          "name": "Submit test results",
          "request": {
            "name": "Submit test results",
            "description": {
              "content": "Submits test results for a sample. Test results are organized by category (cannabinoids, terpenes, pesticides, etc.) with compound data and info fields. All numeric values should be strings to preserve precision. Subsequent submissions overwrite previous data.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v0",
                "labs",
                "sample",
                ":sample_id",
                "test_results"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "sample_id",
                  "description": "(Required) Sample identifier (lab_internal_id, public_key, or regulator_id_to_attach)"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"test_results\": \"<string>\",\n  \"publish_data\": false,\n  \"date_published\": \"<date>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "acf3ca91-e9ae-4b73-a105-2e44601da603",
              "name": "Test results submitted successfully",
              "originalRequest": {
                "url": {
                  "path": [
                    "v0",
                    "labs",
                    "sample",
                    ":sample_id",
                    "test_results"
                  ],
                  "host": [
